# ══════════════════════════════════════════════════════════════════════════════
# BaazarSetu Backend — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=BaazarSetu
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change_me_to_a_very_long_random_secret_key_at_least_64_chars

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://baazarsetu:baazarsetu_pass@localhost:5432/baazarsetu_db
# Sync URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://baazarsetu:baazarsetu_pass@localhost:5432/baazarsetu_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=another_very_long_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OTP ───────────────────────────────────────────────────────────────────────
# Development mode: uses a fixed OTP, no SMS sent
OTP_MODE=development        # development | production
OTP_DEV_CODE=123456         # Fixed OTP in development mode
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Production SMS provider (only needed in production mode)
# Supported: twilio | msg91 | none
OTP_PROVIDER=none
OTP_API_KEY=
OTP_SENDER_ID=BAAZAR

# Twilio (if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (if OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_TYPE=local           # local | s3 | gcs | cloudinary
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20        # Maximum file upload size in MB

# AWS S3 (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

# Cloudinary (if STORAGE_TYPE=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash        # gemini-1.5-flash | gemini-1.5-pro
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# ── Whisper (local) ───────────────────────────────────────────────────────────
# Sizes: tiny, base, small, medium, large-v2, large-v3
# Recommended: small (244MB) for development, medium for production
WHISPER_MODEL=small
WHISPER_DEVICE=cpu           # cpu | cuda
WHISPER_TIMEOUT_SECONDS=120

# ── IndicTrans2 (local HuggingFace model) ─────────────────────────────────────
# Download from: https://huggingface.co/ai4bharat/indictrans2-indic-en-1B
INDICTRANS_MODEL_PATH=models/indictrans2-indic-en-1B
INDICTRANS_DEVICE=cpu        # cpu | cuda
INDICTRANS_ENABLED=false     # Set to true after downloading model

# ── Image Processing (rembg) ──────────────────────────────────────────────────
# Models: u2net, u2netp, u2net_human_seg, isnet-general-use, birefnet-general
REMBG_MODEL=u2net
REMBG_ENABLED=true

# ── PaddleOCR ────────────────────────────────────────────────────────────────
PADDLEOCR_ENABLED=true
PADDLEOCR_LANG=en            # en | hi | ta | te | kn | ml | gu | bn | mr

# ── CLIP ─────────────────────────────────────────────────────────────────────
CLIP_ENABLED=false           # Set to true after installing CLIP
CLIP_MODEL=ViT-B/32

# ── Pricing / ML ─────────────────────────────────────────────────────────────
XGBOOST_MODEL_PATH=models/pricing_model.joblib
# If model file does not exist, fallback algorithm is used
PRICING_USE_FALLBACK=true

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=5/minute     # OTP endpoint rate limit
RATE_LIMIT_API=100/minute    # General API rate limit

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # json | text

# ── Marketplace ───────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
